{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "素笺所需的最小权限：窗口标题、原生对话框、命令行参数",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:default",
    "cli:default"
  ]
}
